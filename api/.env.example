PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/keystride
# Only needed when calling the API directly from another origin (the web app proxies /api).
CORS_ORIGIN=http://localhost:3000
# "true" in production (HTTPS). Session cookies are then Secure.
COOKIE_SECURE=false
# Proxy trust for client IPs: unset locally ("loopback"), "true" on Vercel (its edge sets X-Forwarded-For).
TRUST_PROXY=
